# Single ignore file for the whole monorepo (frontend/ Flutter, backend/ Python).
# Don't add nested .gitignore files; scope rules here with a path prefix instead.

# ---- Agent / local notes (kept out of git on purpose) ----
AGENTS.md
CLAUDE.md
TODO.md
.claude/settings.local.json

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini
._*
Icon[\r]

# ---- Editors / IDEs ----
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
*~
.history/
.atom/
.buildlog/
.svn/
.tags*
migrate_working_dir/

# ---- Secrets / local config ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist
firebase_options.dart
secrets.*
# Flutter --dart-define-from-file configs; only the example is tracked
frontend/config/*.json
!frontend/config/example.json

# ---- Logs / temp / local data ----
*.log
*.tmp
*.bak
*.db
*.db-*
*.sqlite
*.sqlite3
coverage/

