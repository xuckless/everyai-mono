# backend-exp settings. Values here are read in development (`zig build run`);
# the monorepo's root .env is read after this file (first file with a key wins).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# OPENROUTER_API_KEY=sk-or-...          # usually in the root .env
# PORT=8080
# DATABASE_PATH=data/everyai.db
# MARKUP=1.15
# DEV_AUTH=true                         # credential-less requests act as the dev user
# GOOGLE_CLIENT_IDS=                    # comma separated
# STRIPE_SECRET_KEY=sk_test_...         # unset: checkout is mocked
# STRIPE_WEBHOOK_SECRET=whsec_...
