// Deploy with packaging/install/deploy.sh (it copies the release key into public/ first).
{
  "name": "everyai-get",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "routes": [{ "pattern": "get.everyai.dev", "custom_domain": true }],
  "workers_dev": false
}
