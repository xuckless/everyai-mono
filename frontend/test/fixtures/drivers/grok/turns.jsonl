{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "authMethods": [{"id": "cached_token", "name": "Grok account"}, {"id": "xai.api_key", "name": "xAI API key"}], "agentCapabilities": {"loadSession": true}}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "session/new", "id": 2, "params": {"cwd": "{{cwd}}", "mcpServers": []}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "grok-1"}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "session/prompt", "id": 3, "params": {"sessionId": "grok-1", "prompt": [{"type": "text", "text": "go"}], "_meta": {"promptId": "{{session}}", "requestId": "{{session}}"}}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "method": "_x.ai/mcp/servers_updated", "params": {"sessionId": "grok-1", "servers": [{"name": "github", "command": "npx", "env": {"GITHUB_TOKEN": "sk-secret-1"}}]}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "method": "x.ai/task_backgrounded", "params": {"sessionId": "grok-1", "update": {"sessionUpdate": "task_backgrounded", "task_id": "t1", "tool_call_id": "call-bg-1", "command": "npm run dev", "env": {"API_KEY": "sk-secret-2"}}}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "method": "_x.ai/task_completed", "params": {"sessionId": "grok-1", "update": {"sessionUpdate": "task_completed", "task_snapshot": {"task_id": "t1", "command": "npm run dev", "exit_code": 1, "output": "crashed"}}}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "method": "x.ai/unknown_thing", "params": {"sessionId": "grok-1", "apiKey": "sk-secret-3"}}}
