{"dir": "in", "msg": {"jsonrpc": "2.0", "method": "x.ai/session/prompt_complete", "params": {"sessionId": "grok-1", "promptId": "{{session}}", "stopReason": "end_turn"}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "session/prompt", "id": 4, "params": {"sessionId": "grok-1", "prompt": [{"type": "text", "text": "again"}], "_meta": {"promptId": "{{any}}", "requestId": "{{any}}"}}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 3, "result": {"stopReason": "end_turn"}}}
