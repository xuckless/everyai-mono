{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 1, "result": {"protocolVersion": 1, "authMethods": [{"id": "cursor_login", "name": "Cursor Login", "description": "Run `agent login` in a terminal"}], "agentCapabilities": {"loadSession": true, "promptCapabilities": {"embeddedContext": true}, "mcpCapabilities": {"http": true, "sse": true}}}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "session/new", "id": 2, "params": {"cwd": "{{cwd}}", "mcpServers": [{"type": "http", "name": "everyai", "url": "http://127.0.0.1:7777/mcp", "headers": [{"name": "Authorization", "value": "Bearer tok-cursor"}]}]}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 2, "result": {"sessionId": "cur-1", "modes": {"availableModes": [{"id": "agent", "name": "Agent"}, {"id": "plan", "name": "Plan"}, {"id": "ask", "name": "Ask"}], "currentModeId": "agent"}}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "session/set_mode", "id": 3, "params": {"sessionId": "cur-1", "modeId": "plan"}}}
