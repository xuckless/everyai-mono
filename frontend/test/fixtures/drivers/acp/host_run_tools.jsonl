// A made-up generic ACP agent, shaped by the ACP spec: it asks about two calls to EveryAI's own MCP tools (Cursor's MCP input shape). `memory` passes without a card; `check` runs a command, so it waits for the user.
{"dir":"out","msg":{"jsonrpc":"2.0","method":"initialize","id":1,"params":{"protocolVersion":1,"clientCapabilities":{"fs":{"readTextFile":false,"writeTextFile":false},"terminal":false},"clientInfo":{"name":"everyai","title":"EveryAI","version":"0.1.0"}}}}
{"dir":"in","msg":{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":1,"agentCapabilities":{"promptCapabilities":{}},"authMethods":[]}}}
{"dir":"out","msg":{"jsonrpc":"2.0","method":"session/new","id":2,"params":{"cwd":"{{cwd}}","mcpServers":[]}}}
{"dir":"in","msg":{"jsonrpc":"2.0","id":2,"result":{"sessionId":"dsh-1"}}}
{"dir":"out","msg":{"jsonrpc":"2.0","method":"session/prompt","id":3,"params":{"sessionId":"dsh-1","prompt":[{"type":"text","text":"go"}]}}}
{"dir":"in","msg":{"jsonrpc":"2.0","id":"p1","method":"session/request_permission","params":{"sessionId":"dsh-1","toolCall":{"toolCallId":"t1","status":"pending","title":"everyai: memory","kind":"other","rawInput":{"providerIdentifier":"everyai","toolName":"memory","args":{"action":"read"}}},"options":[{"optionId":"yes","name":"Allow","kind":"allow_once"},{"optionId":"no","name":"No","kind":"reject_once"}]}}}
{"dir":"out","msg":{"jsonrpc":"2.0","id":"p1","result":{"outcome":{"outcome":"selected","optionId":"yes"}}}}
{"dir":"in","msg":{"jsonrpc":"2.0","id":"p2","method":"session/request_permission","params":{"sessionId":"dsh-1","toolCall":{"toolCallId":"t2","status":"pending","title":"everyai: check","kind":"other","rawInput":{"providerIdentifier":"everyai","toolName":"check","args":{"command":"dart test"}}},"options":[{"optionId":"yes","name":"Allow","kind":"allow_once"},{"optionId":"no","name":"No","kind":"reject_once"}]}}}
{"dir":"out","msg":{"jsonrpc":"2.0","id":"p2","result":{"outcome":{"outcome":"selected","optionId":"yes"}}}}
{"dir":"in","msg":{"jsonrpc":"2.0","id":3,"result":{"stopReason":"end_turn"}}}
