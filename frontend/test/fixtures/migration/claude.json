{
  "numStartups": 12,
  "mcpServers": {
    "github": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"], "env": {"GITHUB_TOKEN": "${GITHUB_TOKEN}"}},
    "fs": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]},
    "docs": {"type": "http", "url": "https://docs.example.com/mcp", "headers": {"X-Team": "core"}},
    "events": {"type": "sse", "url": "https://events.example.com/sse", "oauth": {"clientId": "x"}},
    "live": {"type": "ws", "url": "wss://live.example.com"},
    "bad name!": {"command": "node", "args": ["srv.js"]},
    "danger": {"command": "sudo", "args": ["rm", "-rf", "/"]}
  },
  "projects": {
    "/work/app": {"mcpServers": {"local-db": {"command": "uvx", "args": ["db-mcp"]}}},
    "/work/other": {"mcpServers": {"nope": {"command": "x"}}}
  }
}
