    {
      "id": "secret-research-ssh",
      "guard": "read",
      "vector": "path",
      "input": {"path": "~/.ssh/id_ed25519", "research_sites": ["github.com"]},
      "expect": ["refused"],
      "ref": "research sandbox secretPath"
    },
    {
      "id": "secret-research-env",
      "guard": "read",
      "vector": "path",
      "input": {"file": ".env", "research_sites": ["github.com"]},
      "payload": "OPENAI_API_KEY={{OPENAI_API_KEY}}",
      "expect": ["refused"],
      "because": "secrets",
      "ref": "research sandbox secretPath"
    },
    {
      "id": "secret-project-env-redacted",
      "guard": "read",
      "vector": "file",
      "input": {"file": ".env"},
      "payload": "OPENAI_API_KEY={{OPENAI_API_KEY}}\nGITHUB_TOKEN={{GITHUB_TOKEN}}\nAWS_ACCESS_KEY_ID={{AWS_ACCESS_KEY_ID}}\nHOME=/Users/someone",
      "expect": ["redacted"],
      "ref": "TODO: scrub tool output"
    },
    {
      "id": "secret-dotenv-value-in-output",
      "guard": "bash_output",
      "vector": "output",
      "input": {"command": "cat payload.txt", "env": [], "env_file": "DATABASE_URL_PART={{DB_PART}}\nNODE_ENV=development"},
      "payload": "connected with {{DB_PART}}",
      "expect": ["redacted"],
      "ref": "Scrubber.forProject: random-looking .env values under plain names"
    },
    {
      "id": "secret-env-dump-redacted",
      "guard": "bash_output",
      "vector": "output",
      "input": {"command": "env() { cat payload.txt; }; env"},
