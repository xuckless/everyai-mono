<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Off: the Code workspace runs commands and Deno, and works in any folder. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Unsigned/ad-hoc builds (scripts/launch.sh). The signed release re-signs with DeveloperID.entitlements,
	     which adds keychain-access-groups (that needs the team's provisioning profile). -->
</dict>
</plist>
