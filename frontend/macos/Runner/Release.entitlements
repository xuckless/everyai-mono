<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Off: the Code workspace runs commands and Deno, and works in any folder. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Unsigned dev builds (0.1.0-dev-nonsigned): no keychain-access-groups, which needs a team.
	     Add <key>keychain-access-groups</key> with $(AppIdentifierPrefix)dev.alidirect.everyai back for the signed
	     release (TODO.md: macOS signing). Keys still go to the login keychain, as in Debug. -->
</dict>
</plist>
