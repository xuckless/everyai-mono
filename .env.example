# Backend environment. Copy to `.env` at the repo root and fill in values.
# backend/config.py loads it via python-dotenv (searches upward from backend/).
# Never put these in frontend config: anything passed to Flutter ships in the app binary.

# ---- Auth / JWT ----
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Database ----
# e.g. postgresql://user:password@localhost:5432/everyai
DATABASE_URL=

# ---- Google Sign-In (OAuth client IDs per platform) ----
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_REDIRECT_URI=

# ---- Model providers ----
OPENAI_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
STABILITY_API_KEY=
